# Copy this file to .env locally. Never commit real keys.
APP_ENV=development
APP_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/confine.db
BETA_ENABLED=true
BETA_MONTHLY_RESPONSES=300

# Gemini has free-tier models suitable for initial testing.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_ASSIGNMENT_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# To switch providers, set AI_PROVIDER=openai and choose a supported model.
OPENAI_API_KEY=

# These remain inactive while BETA_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STUDENT_PRICE_ID=
STRIPE_TOPUP_PRICE_ID=
